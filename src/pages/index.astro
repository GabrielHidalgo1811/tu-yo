---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DayCard from '../components/DayCard.astro';
import PlaceCard from '../components/PlaceCard.astro';
import Memories from '../components/Memories.astro';
import LoveMessage from '../components/LoveMessage.astro';
import Icon from '../components/Icon.astro';
import MapButton from '../components/MapButton.astro';
import { itinerary, places } from '../data/itinerary';
---
<Layout><Hero /><div class="trip-strip"><span><Icon name="calendar" />5 días para nosotros</span><span><Icon name="pin" />Nuestra base: el Obelisco</span><span><Icon name="heart" />Sin prisa, juntos</span></div>
<section id="itinerario" class="section"><div class="section-heading"><div><p class="eyebrow">EL PLAN ES VIVIRLO JUNTOS</p><h2>Cinco días. Mil recuerdos.</h2></div><p>Un poquito de todo lo que nos gusta.<br />Y espacio para lo inesperado.</p></div><div id="trip-now" class="trip-now" hidden aria-live="polite"></div><div class="days-grid">{itinerary.map((day) => <DayCard day={day} />)}</div><p class="section-footnote"><Icon name="clock" size={16} />Las horas son una guía, no una carrera. Todos los horarios son de Buenos Aires.</p></section>
<section id="mapa" class="map-section"><div class="section"><div class="section-heading"><div><p class="eyebrow">DE UN RINCÓN A OTRO</p><h2>Nuestro mapa.</h2></div><p>Un día, una zona, nuevas historias.<br />Cada parada, a un toque de distancia.</p></div><div class="map-layout"><div class="route-note"><Icon name="map" size={44} /><h3>La ciudad es grande.<br /><em>Nuestro plan, simple.</em></h3><p>Salimos desde el Obelisco y descubrimos Buenos Aires, un barrio a la vez.</p><span>GUÍA POR DÍAS · GOOGLE MAPS</span></div><div class="map-days">{itinerary.map((day) => <details class="map-day"><summary><span class="map-day-number">0{day.dayNumber}</span><span><small>{day.weekday} {day.fullDate.slice(-2)} OCT</small><strong>{day.zone}</strong></span><Icon name="plus" /></summary><ul>{day.activities.map((activity) => <li><span><time>{activity.time}</time>{activity.title}{activity.optional && <small>Opcional</small>}</span><MapButton url={activity.mapUrl} label="Abrir mapa" compact /></li>)}</ul></details>)}</div></div></div></section>
<section id="lugares" class="section"><div class="section-heading"><div><p class="eyebrow">POSTALES DE LO QUE VIENE</p><h2>Lugares para enamorarnos.</h2></div><p>De la ciudad, de sus rincones.<br />Y un poquito más de nosotros.</p></div><div class="place-filters" aria-label="Filtrar lugares por día"><button type="button" class="filter active" data-day="all" aria-pressed="true">Todos los lugares</button>{itinerary.map((day) => <button type="button" class="filter" data-day={day.dayNumber} aria-pressed="false">{day.fullDate.slice(-2)} OCT · {day.dayNumber === 5 ? 'La Boca y más' : day.dayNumber === 2 ? 'Recoleta' : day.zone}</button>)}</div><div class="places-grid">{places.map((place) => <div data-place-day={place.dayNumber}><PlaceCard place={place} /></div>)}</div><p class="section-footnote">Las postales pendientes esperan su fotografía. Abre cada lugar para verlo en Google Maps.</p></section>
<Memories /><LoveMessage /></Layout>
<script>
  import { itinerary } from '../data/itinerary';
  import { buenosAiresClock, tripStatus } from '../lib/trip-clock';
  document.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((button) => button.addEventListener('click', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((other) => { const active = other === button; other.classList.toggle('active', active); other.setAttribute('aria-pressed', String(active)); });
    document.querySelectorAll<HTMLElement>('[data-place-day]').forEach((card) => { card.hidden = button.dataset.day !== 'all' && card.dataset.placeDay !== button.dataset.day; });
  }));
  function updateCurrentPlan() {
    const box = document.querySelector<HTMLElement>('#trip-now'); if (!box) return;
    const { date, time } = buenosAiresClock();
    const day = itinerary.find((entry) => entry.fullDate === date);
    box.replaceChildren();
    if (!day || tripStatus().phase !== 'during') { box.hidden = true; return; }
    box.hidden = false;
    const currentIndex = day.activities.findLastIndex((entry) => entry.time <= time);
    const current = day.activities[currentIndex]; const next = day.activities[currentIndex + 1];
    const title = document.createElement('strong'); title.textContent = `Hoy · ${day.zone}`;
    const description = document.createElement('p'); description.textContent = current ? `Según el plan · ${current.time} ${current.title}${next ? ` · Después: ${next.time} ${next.title}` : ' · Disfrutemos el resto del día.'}` : `Empezamos a las ${next?.time}: ${next?.title}`;
    const link = document.createElement('a'); link.href = `/dias/${day.fullDate}/#parada-${Math.max(1, currentIndex + 1)}`; link.textContent = 'Ver el plan de hoy'; link.className = 'map-button';
    box.append(title, description, link);
  }
  updateCurrentPlan(); setInterval(updateCurrentPlan, 60_000);
</script>
