---
import { trip } from '../data/trip';
import Icon from './Icon.astro';
import TravelImage from './TravelImage.astro';
---
<section id="recuerdos" class="section memories-section"><div class="section-heading"><div><p class="eyebrow">LO MEJOR NO CABE EN UNA MALETA</p><h2>Esto recién empieza.</h2></div><p>Hoy son espacios vacíos.<br />Pronto serán nuestras fotos favoritas.</p></div><div class="memories-grid">{trip.memories.map((memory, index) => <figure class="memory-card"><div>{memory.image ? <TravelImage image={memory.image} /> : <><Icon name="camera" size={28} /><span>Una historia por guardar</span></>}</div><figcaption><span>0{index + 1}</span>{memory.title}<Icon name="heart" size={14} /></figcaption></figure>)}</div><div class="favorite-memory"><Icon name="sparkle" size={27} /><div><p class="eyebrow">NUESTRO MOMENTO FAVORITO</p><p>{trip.favoriteMoment}</p></div></div></section>
